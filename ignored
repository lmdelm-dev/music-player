# =============================================================================
# IGNORED — files and data that must NOT be committed to git
# =============================================================================
#
# Two kinds of entries live here:
#   1) IGNORED FILES — build artefacts, caches, virtual envs, IDE/OS junk
#   2) SENSITIVE DATA — config / state that may contain real credentials,
#      API keys, playback history or personal paths.
#
# Treat this file as an audit manifest. If you add a new pattern, add it here
# first; the real .gitignore should mirror it (see .gitignore for the live
# git-ignore rules).
# =============================================================================

# ---------------------------------------------------------------------------
# SENSITIVE DATA  (may contain real credentials / personal info)
# ---------------------------------------------------------------------------
# Provider credentials are persisted in the config file by Config.save().
# It is chmod 0600 on disk but still contains real secrets — never commit it.
config.json
state.json

# ytmusicapi / Spotipy OAuth blobs the library sometimes drops next to config.
ytmusicapi.json
spotipy_token_cache.json
.client-secret.json
.oauth_token.json

# Any dot-file containing secrets, tokens, keys or credentials.
# Examples: .env, .env.local, .credentials, api_key.txt, tokens.txt, .auth
.dotenv
.env
.env.*
.env.local
*.env
.secrets
.secrets.*
.credentials
.credentials.*
api_keys.txt
tokens.txt
.auth
.auth.*
oauth.json
oauth_token.json
client_secret.json
*.key
*.pem
*.p12
*.pfx

# User library directories (local paths that are personal, e.g. /home/syx/Music).
# Library dirs are stored in config.json; the config file above is the real
# leak, but listing the concept here keeps the rule visible.
~/Music
~/music
~/Songs
~/Downloads

